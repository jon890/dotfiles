#!/usr/bin/env python3
"""내 계정 저장소들에 흩어진 같은 이름의 Actions secret 을 한 번에 바꾼다.

GitHub 는 개인 계정 단위 Actions secret 을 두지 않아, 저장소마다 같은 secret 을 따로 갖고 있다.

usage: gh-rotate-secret [--dry-run] [SECRET_NAME]
  SECRET_NAME   기본값 CLAUDE_CODE_OAUTH_TOKEN
  --dry-run     바꿀 저장소만 출력하고 값은 묻지 않는다

대상은 실행할 때마다 다시 찾는다. 내 계정(`gh api user`)의 보관되지 않은 저장소 가운데
그 이름의 secret 을 이미 가진 저장소다. 새 저장소는 secret 을 한 번 넣어 두면 다음부터 포함된다.

값은 stdin 으로만 받는다. 셸 기록과 프로세스 목록에 남지 않게 하려는 것이다.
터미널이면 입력이 화면에 보이지 않게 묻는다. 파이프로 넘겨도 된다.

종료 코드: 0 모두 성공, 1 일부 저장소 실패, 2 인자·환경 오류이거나 대상이 없음
"""
import getpass
import json
import shutil
import subprocess
import sys

DEFAULT_NAME = "CLAUDE_CODE_OAUTH_TOKEN"


def log(msg=""):
    print(msg, file=sys.stderr)


def die(msg):
    log(msg)
    sys.exit(2)


def gh(*args, input=None):
    return subprocess.run(
        ["gh", *args], input=input, text=True, capture_output=True
    )


def parse_args(argv):
    dry_run = False
    name = DEFAULT_NAME
    for arg in argv:
        if arg in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        elif arg == "--dry-run":
            dry_run = True
        elif arg.startswith("-"):
            die(f"알 수 없는 옵션: {arg}")
        else:
            name = arg
    return dry_run, name


def find_targets(owner, name):
    r = gh("repo", "list", owner, "--limit", "500", "--no-archived",
           "--json", "nameWithOwner")
    if r.returncode != 0:
        die("저장소 목록을 가져오지 못했습니다.")
    targets = []
    for repo in (x["nameWithOwner"] for x in json.loads(r.stdout)):
        # admin 권한이 없거나 Actions 가 꺼진 저장소는 조회가 실패한다. 대상이 아니므로 건너뛴다.
        s = gh("secret", "list", "-R", repo, "--json", "name")
        if s.returncode != 0:
            continue
        try:
            if any(x["name"] == name for x in json.loads(s.stdout)):
                targets.append(repo)
        except (ValueError, KeyError, TypeError):
            continue
    return targets


def read_value(name):
    if sys.stdin.isatty():
        return getpass.getpass(f"새 {name} 값: ")
    return sys.stdin.readline().rstrip("\r\n")


def main():
    dry_run, name = parse_args(sys.argv[1:])

    if shutil.which("gh") is None:
        die("gh 가 없습니다.")
    r = gh("api", "user", "-q", ".login")
    owner = r.stdout.strip()
    if r.returncode != 0 or not owner:
        die("gh 로그인 상태를 확인하세요 (gh auth status).")

    log(f"{owner} 의 저장소에서 {name} 을 가진 곳을 찾는 중...")
    targets = find_targets(owner, name)
    if not targets:
        die(f"{name} 을 가진 저장소가 없습니다.")
    for repo in targets:
        log(f"  {repo}")
    if dry_run:
        return 0

    value = read_value(name)
    if not value:
        die("값이 비어 있어 아무것도 바꾸지 않았습니다.")

    failed = False
    for repo in targets:
        # 값은 argv 가 아니라 stdin 으로만 넘긴다.
        if gh("secret", "set", name, "-R", repo, input=value).returncode == 0:
            log(f"  성공  {repo}")
        else:
            log(f"  실패  {repo}")
            failed = True

    if failed:
        log(f"일부 저장소에서 실패했습니다. gh secret set {name} -R <저장소> 로 그 저장소만 다시 넣으세요.")
        return 1
    log(f"{len(targets)}개 저장소의 {name} 을 바꿨습니다.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
