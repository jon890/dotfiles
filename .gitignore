# 기본적으로 모든 파일과 폴더를 무시
*

# git으로 관리할 파일들만 예외 처리
!.bashrc
!.gitconfig
!.gitconfig-personal
!.gitignore
!.zimrc
!.zshrc
!.tool-versions

# git 훅 (core.hooksPath = .githooks)
!.githooks/
.githooks/*
!.githooks/pre-commit

# SSH 설정 파일
!.ssh/
.ssh/*
!.ssh/config

# zsh 설정 디렉토리
!.zshrc.d/
.zshrc.d/*
!.zshrc.d/mise.sh
!.zshrc.d/zim.sh
!.zshrc.d/zoxide.sh
!.zshrc.d/ssh.sh
!.zshrc.d/zz-kube-ps1.sh
!.testcontainers.properties

# XDG config
!.config/
.config/*

# mise 설정
!.config/mise/
.config/mise/*
!.config/mise/config.toml

# ghostty 설정
!.config/ghostty/
.config/ghostty/*
!.config/ghostty/config

# Claude Code 전역 instruction
!.claude/
.claude/*
!.claude/CLAUDE.md
!.claude/*-overlay.md
!.claude/rules/
.claude/rules/*
!.claude/rules/*.md
!.claude/references/
.claude/references/*
!.claude/references/*.md
!.claude/references/assets/
.claude/references/assets/*
!.claude/references/assets/*.html
!.claude/scripts/
.claude/scripts/*
!.claude/scripts/*.sh
!.claude/scripts/*.py
!.claude/scripts/browser-driver
!.claude/hud/
.claude/hud/*
!.claude/hud/omc-hud-wrap.sh
!.claude/bin/
.claude/bin/*
!.claude/bin/gh-rotate-secret

# Codex 전역 instruction
!.codex/
.codex/*
!.codex/AGENTS.md
!.codex/career-write.config.toml
!.codex/career-research.config.toml
!.codex/cron-light.config.toml
!.codex/final-review.config.toml

# Claude Code mods
!.claude/mods/
.claude/mods/*
!.claude/mods/.claude-plugin/
!.claude/mods/work-board/
.claude/mods/work-board/*
!.claude/mods/work-board/.claude-plugin/
.claude/mods/work-board/.claude-plugin/*
!.claude/mods/work-board/.claude-plugin/plugin.json
!.claude/mods/work-board/hooks/
.claude/mods/work-board/hooks/*
!.claude/mods/work-board/hooks/*.json
!.claude/mods/work-board/hooks/*.js
!.claude/mods/work-board/bin/
!.claude/mods/work-board/tests/
.claude/mods/work-board/tests/*
!.claude/mods/work-board/tests/*.test.ts
.claude/mods/work-board/bin/*
!.claude/mods/work-board/bin/*.py
!.claude/mods/work-board/README.md
!.claude/mods/.claude-plugin/marketplace.json

# Gradle 개인 init 스크립트 (이 머신의 ai-analysis worktree 병렬 build 용 docker 테스트 슬롯)
!.gradle/
.gradle/*
!.gradle/init.d/
.gradle/init.d/*
!.gradle/init.d/*.init.gradle.kts
